    const bbl=String(row[ROW.BBL] || "");
    if (evictionCache.has(bbl)) return evictionCache.get(bbl);

    const promise=(async()=>{
      const cutoff3=isoDateYearsAgo(3);
      let records=[];

      // Primary query: exact text BBL match.

<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="description" content="Self-contained NYC Housing Intelligence public research dashboard using source-confirmed rent-stabilized building lists and HPD public records.">
<title>NYC Housing Intelligence Map</title>
<style>
:root{
  --bg:#f7f5f0;
  --paper:#fcfbf8;
  --card:#fff;
  --ink:#1e2430;
  --muted:#5f6775;
  --rule:#d8d3ca;
  --navy:#0f1b2d;
  --navy2:#243b57;
  --gold:#b98c43;
  --gold-dark:#7d5d26;
  --shadow:0 10px 28px rgba(20,26,40,.08);
  --radius:20px;
  --max:1160px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  font-family:Inter,Arial,sans-serif;
  color:var(--ink);
  background:var(--bg);
  line-height:1.55;
  -webkit-font-smoothing:antialiased;
}
button,input,select{font:inherit}
button{cursor:pointer}
a{color:inherit}
.page{width:min(var(--max),92%);margin:0 auto;padding:34px 0 42px}
.hero,.panel,.controls,.howto,.metric,.notice{
  border:1px solid var(--rule);
  background:var(--paper);
  box-shadow:var(--shadow);
}
.hero{
  border-radius:22px;
  padding:30px 32px;
  background:linear-gradient(135deg,#fcfbf8 0%,#f1eee7 100%);
}
.hero-top{display:flex;justify-content:space-between;gap:14px;align-items:center;flex-wrap:wrap}
.eyebrow,.panel-kicker,label,.metric-label{
  margin:0;
  color:var(--muted);
  font-size:.72rem;
  font-weight:700;
  letter-spacing:.1em;
  text-transform:uppercase;
}
.top-link,.button{
  border:1px solid var(--rule);
  border-radius:999px;
  padding:9px 14px;
  background:#fff;
  color:var(--navy);
  font-size:.82rem;
  font-weight:700;
  text-decoration:none;
}
.top-link:hover,.button:hover{background:var(--navy);color:#fff}
h1,h2,h3{
  font-family:"Cormorant Garamond",Georgia,serif;
  color:var(--navy);
}
h1{
  margin:10px 0 10px;
  font-size:clamp(3rem,6vw,5rem);
  line-height:.94;
  letter-spacing:-.04em;
}
.hero-subtitle{max-width:900px;margin:0;color:#374556;font-size:1rem}
.source-note{
  margin:16px 0 0;
  padding:12px 14px;
  border:1px solid #eadfc9;
  border-left:5px solid var(--gold);
  border-radius:14px;
  background:#fffaf1;
  color:#5e4a2a;
  font-size:.86rem;
}
.hero-meta{display:flex;flex-wrap:wrap;gap:8px 18px;margin-top:14px;color:var(--muted);font-size:.82rem}
.howto{
  margin-top:16px;
  border-radius:18px;
  padding:16px 18px;
  border-left:5px solid var(--gold);
  background:#fffaf1;
}
.howto-title{margin:0;color:var(--navy);font-size:.78rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase}
.howto ol{display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin:10px 0 0;padding-left:22px;color:#445467;font-size:.84rem}
.controls{
  margin:16px 0;
  padding:16px;
  border-radius:20px;
  display:grid;
  grid-template-columns:2fr repeat(5,1fr) auto auto auto;
  gap:10px;
  align-items:end;
  background:linear-gradient(180deg,#fcfbf8 0%,#f6f2ea 100%);
}
.control{min-width:0}
label{display:block;margin-bottom:6px}
input,select{
  width:100%;
  min-height:42px;
  border:1px solid var(--rule);
  border-radius:12px;
  padding:9px 11px;
  background:#fff;
  color:var(--ink);
  outline:none;
}
input:focus,select:focus{border-color:var(--gold);box-shadow:0 0 0 3px rgba(185,140,67,.14)}
.control-button{
  min-height:42px;
  border-radius:999px;
  padding:9px 14px;
  border:1px solid var(--rule);
  font-size:.82rem;
  font-weight:800;
  white-space:nowrap;
}
.control-button.primary{background:var(--navy);color:#fff;border-color:var(--navy)}
.control-button.secondary{background:#fff;color:var(--navy)}
.dashboard{
  display:grid;
  grid-template-columns:minmax(0,1.45fr) minmax(340px,1fr);
  gap:14px;
  align-items:stretch;
}
.panel{border-radius:var(--radius);overflow:hidden}
.panel-head{
  min-height:78px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:14px;
  padding:15px 18px;
  border-bottom:1px solid var(--rule);
  background:linear-gradient(180deg,#fdfcf9 0%,#f4f1ea 100%);
}
.panel-head h2{margin:3px 0 0;font-size:2rem;line-height:1}
.map-count{text-align:right}
.map-count strong{display:block;color:var(--navy);font-size:1.35rem}
.map-count span{display:block;color:var(--muted);font-size:.72rem}
.map-shell{position:relative;height:660px;background:#dfe8ec}
#mapCanvas{display:block;width:100%;height:100%;touch-action:none;cursor:grab}
#mapCanvas.dragging{cursor:grabbing}
.loading{
  position:absolute;inset:0;z-index:20;
  display:grid;place-content:center;gap:10px;text-align:center;
  padding:24px;background:rgba(252,251,248,.96);color:var(--navy)
}
.loading[hidden]{display:none}
.spinner{width:36px;height:36px;margin:0 auto;border:4px solid #e5dfd4;border-top-color:var(--gold);border-radius:50%;animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
.map-tools{
  position:absolute;top:14px;right:14px;z-index:5;
  display:grid;gap:6px
}
.map-tools button{
  width:38px;height:38px;border:1px solid var(--rule);border-radius:10px;background:rgba(255,255,255,.95);color:var(--navy);font-size:1.25rem;font-weight:800;box-shadow:0 5px 15px rgba(20,26,40,.13)
}
.legend{
  position:absolute;left:14px;bottom:14px;z-index:5;
  width:205px;padding:11px 12px;border:1px solid var(--rule);border-radius:12px;background:rgba(252,251,248,.95);box-shadow:0 5px 16px rgba(20,26,40,.12);font-size:.72rem;color:var(--muted)
}
.legend strong{display:block;color:var(--navy);margin-bottom:6px}
.legend-row{display:flex;align-items:center;gap:7px;margin:5px 0}
.legend-dot{width:10px;height:10px;border-radius:50%;background:var(--gold);border:1px solid var(--gold-dark)}
.legend-line{width:18px;border-top:2px solid var(--navy2)}
.tooltip{
  position:absolute;z-index:8;pointer-events:none;
  max-width:250px;padding:9px 10px;border:1px solid var(--rule);border-radius:10px;background:#fff;box-shadow:0 8px 20px rgba(20,26,40,.15);font-size:.75rem
}
.tooltip[hidden]{display:none}
.tooltip strong{display:block;color:var(--navy);font-size:.82rem}

.violation-popup{
  position:absolute;
  z-index:12;
  width:min(286px,calc(100% - 28px));
  padding:13px;
  border:1px solid var(--rule);
  border-radius:14px;
  background:rgba(252,251,248,.98);
  box-shadow:0 14px 34px rgba(15,27,45,.22);
  color:var(--ink);
  transform-origin:bottom center;
  transition:opacity .14s ease,transform .14s ease;
}
.violation-popup[hidden]{display:none}
.violation-popup::after{
  content:"";
  position:absolute;
  left:50%;
  bottom:-8px;
  width:14px;
  height:14px;
  transform:translateX(-50%) rotate(45deg);
  border-right:1px solid var(--rule);
  border-bottom:1px solid var(--rule);
  background:var(--paper);
}
.violation-popup.below::after{
  top:-8px;
  bottom:auto;
  border:0;
  border-left:1px solid var(--rule);
  border-top:1px solid var(--rule);
}
.violation-popup-close{
  position:absolute;
  top:8px;
  right:8px;
  width:26px;
  height:26px;
  border:1px solid var(--rule);
  border-radius:50%;
  background:#fff;
  color:var(--navy);
  font-size:1rem;
  line-height:1;
}
.violation-popup-title{
  margin:0 30px 8px 0;
  color:var(--navy);
  font-family:"Cormorant Garamond",Georgia,serif;
  font-size:1.3rem;
  line-height:1;
}
.violation-popup-grid{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:6px;
}
.violation-popup-stat{
  padding:7px 5px;
  border:1px solid var(--rule);
  border-radius:9px;
  background:#fff;
  text-align:center;
}
.violation-popup-stat span{
  display:block;
  color:var(--muted);
  font-size:.55rem;
  font-weight:800;
  letter-spacing:.04em;
  text-transform:uppercase;
}
.violation-popup-stat strong{
  display:block;
  margin-top:2px;
  color:var(--navy);
  font-size:1rem;
}
.violation-popup-loading,
.violation-popup-error,
.violation-popup-empty{
  margin:0;
  padding:9px;
  border-radius:9px;
  background:#f4f6f8;
  color:var(--muted);
  font-size:.7rem;
  line-height:1.4;
}
.violation-popup-error{background:#fff7ed;color:#8a5b22}
.violation-popup-recent{
  margin:9px 0 0;
  padding:0;
  list-style:none;
  display:grid;
  gap:6px;
}
.violation-popup-recent li{
  padding-top:6px;
  border-top:1px solid #eee8dd;
}
.violation-popup-recent strong{
  display:block;
  color:var(--navy);
  font-size:.67rem;
  line-height:1.3;
}
.violation-popup-recent small{
  display:block;
  margin-top:2px;
  color:var(--muted);
  font-size:.59rem;
}
.violation-popup-source{
  margin:8px 0 0;
  color:var(--muted);
  font-size:.57rem;
  line-height:1.35;
}
@media(max-width:480px){
  .violation-popup{width:min(266px,calc(100% - 22px));padding:11px}
  .violation-popup-grid{grid-template-columns:repeat(2,1fr)}
}

.map-attribution{position:absolute;right:8px;bottom:6px;z-index:6;padding:3px 6px;border-radius:5px;background:rgba(255,255,255,.86);color:#667385;font-size:.58rem}.map-attribution .offline{color:#8b672b;font-weight:700}.map-caption{margin:0;padding:10px 16px;border-top:1px solid var(--rule);color:var(--muted);font-size:.72rem}
.property-panel{min-height:718px}
.detail-content{padding:16px;max-height:640px;overflow:auto}
.empty-detail{display:grid;place-content:center;min-height:520px;text-align:center;color:var(--muted);padding:24px}
.empty-detail strong{display:block;color:var(--navy);font-family:"Cormorant Garamond",Georgia,serif;font-size:1.8rem}
.property-title{margin:0;color:var(--navy);font-family:"Cormorant Garamond",Georgia,serif;font-size:2rem;line-height:1}
.property-subline{margin:6px 0 0;color:var(--muted);font-size:.76rem}
.source-banner{margin-top:12px;padding:10px 11px;border-left:4px solid var(--gold);border-radius:8px;background:#fff5df;color:#654d25;font-size:.76rem}
.fact-grid,.violation-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}
.fact,.violation-stat{padding:9px 10px;border:1px solid var(--rule);border-radius:12px;background:#fff}
.fact span,.violation-stat span{display:block;color:var(--muted);font-size:.62rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase}
.fact strong,.violation-stat strong{display:block;margin-top:3px;color:var(--navy);font-size:.9rem;overflow-wrap:anywhere}
.detail-section{margin-top:16px;padding-top:14px;border-top:1px solid var(--rule)}
.detail-section h3{margin:0 0 9px;font-size:1.25rem}
.role{padding:8px 9px;border:1px solid var(--rule);border-radius:10px;background:#fff;margin-top:7px}
.role span{display:block;color:var(--gold-dark);font-size:.62rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase}
.role strong{display:block;margin-top:2px;color:var(--navy);font-size:.78rem;overflow-wrap:anywhere}
.live-status{padding:10px;border-radius:10px;background:#f4f6f8;color:var(--muted);font-size:.75rem}
.recent-list{list-style:none;padding:0;margin:10px 0 0;display:grid;gap:8px}
.recent-list li{padding:9px;border:1px solid var(--rule);border-radius:10px;background:#fff}
.recent-list strong{display:block;color:var(--navy);font-size:.76rem}
.recent-list small{display:block;margin-top:3px;color:var(--muted);font-size:.67rem}
.action-row{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:14px}
.action-row a,.action-row button{display:inline-flex;justify-content:center;align-items:center;text-align:center;text-decoration:none}
.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin:14px 0}
.metric{border-radius:16px;padding:13px 14px;border-top:3px solid var(--navy)}
.metric-value{margin:4px 0 2px;color:var(--navy);font-size:1.5rem;font-weight:800}
.metric-note{margin:0;color:var(--muted);font-size:.72rem}

.violation-guide{
  margin:14px 0;
  padding:20px;
  border:1px solid var(--rule);
  border-radius:20px;
  background:var(--paper);
  box-shadow:var(--shadow);
}
.violation-guide-head{
  display:flex;
  align-items:end;
  justify-content:space-between;
  gap:18px;
  margin-bottom:14px;
}
.violation-guide h2{
  margin:4px 0 0;
  font-size:2rem;
  line-height:1;
}
.violation-guide-intro{
  max-width:520px;
  margin:0;
  color:var(--muted);
  font-size:.8rem;
  line-heigh